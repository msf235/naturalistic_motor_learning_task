<mujoco model="test">
  <compiler angle="radian"/>
  <option timestep="0.001" integrator="implicitfast"/>
  <visual>
    <map force="0.1" zfar="60"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global offwidth="2560" offheight="1440" elevation="-20" azimuth="120"/>
  </visual>
  <visual>
    <map force="0.1" zfar="30"/>
    <rgba haze="0.15 0.25 0.35 1"/>
      <!--offwidth="2560" offheight="1440"-->
    <global
      elevation="20"
      azimuth="10"
      />
    <headlight ambient=".8 .8 .8" specular=".8 .8 .8"/>
  </visual>
  <option gravity="0 0 -9.8"/>
  <worldbody>
    <!-- <body gravcomp="1"> -->
    <body name="arm">
      <geom name="arm" type="box" fromto="0.08 .08 .08 .1 .12 .12" size=".2" density="800"
        rgba="1 1 1 .5"/>
      <joint type="slide" axis="1 1 1" pos=".1 0 0" stiffness="2000" damping="100" name="arm"/>
      <body name="arm_core" pos=".12 .14 .02">
        <geom name="arm_core" type="sphere" size=".01" pos="0 0 0" density="1" rgba="1 .5 0 1"/>
      </body>
    </body>
    <body>
      <geom name="stand" type="box" fromto="0 0 -.15 0 0 -.4" size=".07" density="800"/>
    </body>
    <body pos="0 0 -.115">
      <freejoint/>
      <geom name="ball" type="box" size=".03 .03 .03" density="600" rgba=".8 .3 0 .5"/>
      <body name="ball_core" pos="0 0 0">
        <geom name="ball_core" type="sphere" size=".01" pos="0 0 0" density="1" rgba="1 1 0 1"/>
      </body>
    </body>
  </worldbody>
  <contact>
    <pair geom1="arm_core" geom2="ball_core" friction="2 2 .01 .0002 .0002" solimp="0.1 0.99 0.0005" solref="0.002 1" margin=".08" gap=".08"/>
  </contact>
  <actuator>
    <position joint="arm" kv="100" kp="500"/>
    <adhesion name="adh" body="arm_core" gain="800" ctrlrange="0 1"/>
  </actuator>
</mujoco>
